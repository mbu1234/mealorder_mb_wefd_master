{
  "id": "testExpenseEdit",
  "endPoints": [
    {
      "name": "getExpenseEntry",
      "url": "<% `https://api.workday.com/expense/v1/entries/{{queryParams.expenseId}}` %>",
      "authType": "sso"
    }
  ],
  "outboundData" : {
    "outboundEndPoints" : [
      {
        "name": "patchExpenseEntry",
        "url": "<% `https://api.workday.com/expense/v1/entries/{{queryParams.expenseId}}` %>",
        "authType": "sso",
        "httpMethod": "PATCH",
        "onSend": "<%
          {
            'memo': memoWidget.value,
            'merchant': merchantWidget.value,
            'amount': {
              'currency': 'USD',
              'value': valueWidget.value
            }
          }
        %>"
      }
    ]
  },
  "presentation": {
    "title": {
      "type": "title",
      "label": "<% `Date of Expense: {{getExpenseEntry.date}}` %>"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "date",
          "id": "dateWidget",
          "label": "Date",
          "value": "<% getExpenseEntry.date %>"
        },
        {
          "type": "text",
          "id": "memoWidget",
          "label": "Memo",
          "value": "<% getExpenseEntry.memo ?? 'No memo found' %>"
        },
        {
          "type": "text",
          "id": "merchantWidget",
          "label": "Merchant",
          "value": "<% getExpenseEntry.merchant ?? 'No merchant found' %>"
        },
        {
          "type": "text",
          "id": "valueWidget",
          "label": "Value (USD $)",
          "value": "<% getExpenseEntry.amount.value ?? '' %>"
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [ ]
    }
  }
}