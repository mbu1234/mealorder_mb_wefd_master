{
  "appProperties": [],
  "flowDefinitions": [
    {
      "id": "restaurantCreateFlow",
      "flowSteps": [
        {
          "id": "restaurantCreateStep",
          "startsFlow": true,
          "transitions": [
            {
              "order": "a",
              "value": "restaurantCreateConfirmStep",
              "condition": "true"
            }
          ],
          "taskId": "restaurantCreate"
        },
        {
          "id": "restaurantCreateConfirmStep",
          "transitions": [
            {
              "order": "a",
              "value": "restaurantCreateSuccessStep",
              "condition": "<% true %>"
            }
          ],
          "taskId": "restaurantCreateConfirm"
        },
        {
          "id": "restaurantCreateSuccessStep",
          "taskId": "restaurantCreateSuccess",
          "endsFlow": true
        }
      ]
    },
    {
      "id": "restaurantOrderCreateFlow",
      "flowSteps": [
        {
          "id": "restaurantOrderCreateStep",
          "transitions": [
            {
              "order": "a",
              "value": "restaurantOrderForSelfStep",
              "condition": "<% flowVariables.restaurantOrderType == 'me' %>"
            },
            {
              "order": "b",
              "value": "restaurantOrderForWorkerStep",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "restaurantOrderCreate"
        },
        {
          "id": "restaurantOrderForSelfStep",
          "transitions": [
            {
              "order": "a",
              "value": "restaurantOrderCreateConfirm",
              "condition": "true"
            }
          ],
          "taskId": "restaurantOrderCreateForSelf"
        },
        {
          "id": "restaurantOrderForWorkerStep",
          "transitions": [
            {
              "order": "a",
              "value": "restaurantOrderCreateConfirm",
              "condition": "true"
            }
          ],
          "taskId": "restaurantOrderCreateForWorker"
        },
        {
          "id": "restaurantOrderCreateConfirm",
          "transitions": [
            {
              "order": "a",
              "value": "restaurantOrderCreateSuccess",
              "condition": "true"
            }
          ],
          "taskId": "restaurantOrderCreateConfirm"
        },
        {
          "id": "restaurantOrderCreateSuccess",
          "endsFlow": true,
          "taskId": "restaurantOrderCreateSuccess"
        }
      ]
    }
  ],
