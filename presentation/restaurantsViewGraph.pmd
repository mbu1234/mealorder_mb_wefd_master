{
  "id": "restaurantsViewGraph",
  "endPoints": [
    {
      "name": "getRestaurants_1",
      "graphQuery": {
        "queryId": "getRestaurants_1"
      },
      "httpMethod": "POST",
      "authType": "sso",
      "url": "https://api.workday.com/graphql/v1",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "View Restaurants"
    },
    "body": {
      "type": "section",
      "children": [
        {
          "type": "grid",
          "id": "restaurantsGrid",
          "label": "Restaurants",
          "rows": "<% getRestaurants_1.data.restaurants.data %>",
          "rowVariableName": "restaurant",
          "columns": [
            {
              "type": "column",
              "columnId": "descriptorColumn",
              "label": "Descriptor",
              "cellTemplate": {
                "type": "text",
                "id": "descriptor",
                "value": "<% restaurant.descriptor %>"
              }
            },
            {
              "type": "column",
              "columnId": "nameColumn",
              "label": "Name",
              "cellTemplate": {
                "type": "text",
                "id": "name",
                "value": "<% restaurant.name %>"
              }
            },
            {
              "type": "column",
              "columnId": "idColumn",
              "label": "ID",
              "cellTemplate": {
                "type": "text",
                "id": "id",
                "value": "<% restaurant.workdayID?.id %>"
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": "false",
          "value": "<b>Generated by Workday Extend Developer Copilot.</b>"
        }
      ]
    }
  }
}