{
  "id": "createRestaurantOrder",
  "endPoints": [
    {
      "name": "getWorkers",
      "graphQuery": {
        "queryId": "getWorkers"
      },
      "httpMethod": "POST",
      "authType": "sso",
      "url": "https://api.workday.com/graphql/v1",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "getRestaurants_2",
      "graphQuery": {
        "queryId": "getRestaurants_2"
      },
      "httpMethod": "POST",
      "authType": "sso",
      "url": "https://api.workday.com/graphql/v1",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "createRestaurantOrder",
        "httpMethod": "POST",
        "authType": "sso",
        "url": "https://api.workday.com/graphql/v1",
        "graphQuery": {
          "queryId": "createRestaurantOrder",
          "variables": {
            "mealorder_mb_wefd_master_pgbbrx_createRestaurantOrder_input": {
              "orderYear": "<% orderYear.value %>",
              "orderDetails": "<% orderDetails.value %>",
              "orderAddress": "<% orderAddress.value %>",
              "orderMonth": "<% orderMonth.value %>",
              "createdBy": "<% graph:createId(createdBy.value) %>",
              "restaurantName": "<% restaurantName.value %>",
              "restaurant": "<% graph:createId(restaurant.value) %>",
              "deliveryDate": "<% deliveryDate.value.format('yyyy-MM-dd') ?? '' %>",
              "deliveryEndDate": "<% deliveryEndDate.value.format('yyyy-MM-dd') ?? '' %>"
            }
          }
        },
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 429
          }
        ]
      }
    ],
    "responseErrorDetail": {
      "errors": "<% errors.map(error => { error.message }); %>"
    }
  },
  "presentation": {
    "title": {
      "type": "title",
      "label": "Create Restaurant Order"
    },
    "body": {
      "type": "section",
      "children": [
        {
          "type": "text",
          "id": "orderYear",
          "label": "Order Year"
        },
        {
          "type": "text",
          "id": "orderDetails",
          "label": "Order Details"
        },
        {
          "type": "text",
          "id": "orderAddress",
          "label": "Order Address"
        },
        {
          "type": "text",
          "id": "orderMonth",
          "label": "Order Month"
        },
        {
          "type": "instanceList",
          "id": "createdBy",
          "label": "Created By",
          "required": true,
          "idKey": "workdayID.id",
          "values": "<% getWorkers.data.worker.data %>"
        },
        {
          "type": "text",
          "id": "restaurantName",
          "label": "Restaurant Name"
        },
        {
          "type": "instanceList",
          "id": "restaurant",
          "label": "Restaurant",
          "required": true,
          "idKey": "workdayID.id",
          "values": "<% getRestaurants_2.data.restaurants.data %>"
        },
        {
          "type": "date",
          "id": "deliveryDate",
          "label": "Delivery Date"
        },
        {
          "type": "date",
          "id": "deliveryEndDate",
          "label": "Delivery End Date"
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": false,
          "value": "<b>Generated by Workday Extend Developer Copilot.</b>"
        }
      ]
    }
  }
}